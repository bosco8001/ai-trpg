{
  "name": "ai-trpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "llm:check": "node --import tsx src/server/llm/check.ts",
    "db:migrate": "node-pg-migrate up --envPath .env",
    "db:migrate:dry-run": "node-pg-migrate up --dry-run --envPath .env",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^17.4.2",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
