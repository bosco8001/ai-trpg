# 只供本機開發。複製為 .env 後，修改 POSTGRES_PASSWORD 與 DATABASE_URL 中的密碼。
POSTGRES_DB=ai_trpg
POSTGRES_USER=ai_trpg
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgres://ai_trpg:change-this-local-password@127.0.0.1:5433/ai_trpg
# API 預設使用記憶體；改成 postgres 才會把權威 TEST state 存入上述資料庫。
DOMAIN_STORAGE=memory
# Phase 31 修復前備份：Memory 專用私有目錄，請勿放在 web root 或 Git。
REPAIR_BACKUP_DIRECTORY=.repair-backups
# 完整封裝上限最多 32 MiB；總容量預設 1 GiB，超限拒絕新增，不自動刪除。
REPAIR_BACKUP_MAX_BYTES=33554432
REPAIR_ARCHIVE_MAX_BYTES=1073741824
# Phase 9 固定敘事模式：normal、unavailable、timeout、malformed。
NARRATION_FIXTURE_MODE=normal
# Phase 11 TEST combat sandbox 預設關閉；需要手動測試時才設為 1。
COMBAT_SANDBOX=0
# Sandbox 固定骰序列：normal 或 tie。正式 runtime 不依賴此 fixture。
COMBAT_ROLL_FIXTURE_MODE=normal
